{
  "luci-app-azizi-netspeed-monitor": {
    "description": "Main Page access",
    "read": {
      "file": {
        "/www/luci-static/resources/view/status/include": [ "list" ],
        "/proc/net/arp": [ "read" ],
        "/usr/sbin/nft": [ "exec" ],
        "/bin/date": [ "exec" ],
        "/root/azizi_netspeed/usage/*": [ "read" ],
        "/root/azizi_netspeed/bwlimit/limits.json": [ "read" ],
        "/tmp/azizi_netspeed/top.json": [ "read" ]
      },
      "ubus": {
        "file": [ "list", "read", "exec" ],
        "system": [ "board", "info" ],
        "luci-rpc": [ "getDHCPLeases", "getHostHints" ],
        "iwinfo": [ "assoclist" ]
      }
    },
    "write": {
      "file": {
        "/root/azizi_netspeed/bwlimit/limits.json": [ "write" ],
        "/bin/sh": [ "exec" ]
      },
      "ubus": {
        "file": [ "write", "exec" ]
      }
    }
  }
}
